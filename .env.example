# Copia este archivo como ".env" y pon los datos de tu instancia de Neo4j AuraDB.
# (El archivo de credenciales que descargas de Aura ya trae estas variables:
#  puedes renombrarlo a ".env" directamente.)
NEO4J_URI=neo4j+s://XXXXXXXX.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=pon_aqui_tu_contraseña
NEO4J_DATABASE=neo4j
